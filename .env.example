# Mapbox public token (https://account.mapbox.com/access-tokens). Without it a free preview basemap is used.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Supabase project (Settings -> API). Without these the app runs in single-browser demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Staff passcode for the VPSAS dashboard (demo default: vpsas2026)
NEXT_PUBLIC_STAFF_PASSCODE=
